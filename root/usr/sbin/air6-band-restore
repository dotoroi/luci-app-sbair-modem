#!/bin/sh
# Restore only the saved LTE/NR band masks. This deliberately does not run the
# broader modem boot workflow (APN, SIM lock, IMS, or SMS notification setup).
set -u

MODEM=${AIR6_MODEM_BIN:-/usr/bin/sbair-modem}
TAG=air6-band-restore
LTE=$(uci -q get sbair.band.lte 2>/dev/null || true)
NR=$(uci -q get sbair.band.nr 2>/dev/null || true)

log() { logger -t "$TAG" "$*"; }

if [ -z "$LTE" ] && [ -z "$NR" ]; then
	log 'no saved LTE or NR band selection; skip'
	exit 0
fi

mask_for() {
	printf '%s\n' "$1" | awk -v words="$2" '
	{
		n = split($0, bands, ",")
		for (i = 1; i <= n; i++) {
			if (bands[i] !~ /^[0-9]+$/ || bands[i] < 1 || bands[i] > words * 32) {
				bad = 1
				continue
			}
			if (seen[bands[i]]++) continue
			w = int((bands[i] - 1) / 32) + 1
			bits[w] += 2 ^ ((bands[i] - 1) % 32)
		}
	}
	END {
		if (bad || n == 0) exit 1
		for (i = 1; i <= words; i++) printf "%08X", bits[i]
	}'
}

LTE_MASK=
NR_MASK=
[ -z "$LTE" ] || LTE_MASK=$(mask_for "$LTE" 2) || { log 'invalid saved LTE band list'; exit 1; }
[ -z "$NR" ] || NR_MASK=$(mask_for "$NR" 3) || { log 'invalid saved NR band list'; exit 1; }

read_masks() {
	line=$("$MODEM" at -t 5 -r 'AT+EPBSEH?' 2>/dev/null | sed -n 's/^+EPBSEH: *//p' | head -n 1 | tr -d '" ')
	[ -n "$line" ] || return 1
	IFS=, read -r GSM UMTS CUR_LTE CUR_NR EXTRA <<EOF
$line
EOF
	[ -n "${GSM:-}" ] && [ -n "${UMTS:-}" ] && [ -n "${CUR_LTE:-}" ] && [ -n "${CUR_NR:-}" ]
}

# Wait for the vendor AT service, then keep correcting the masks while the
# modem performs its delayed post-boot initialization (up to two minutes).
ready=0
for i in $(seq 30); do
	if read_masks; then ready=1; break; fi
	sleep 2
done
if [ "$ready" -ne 1 ]; then
	log 'AT+EPBSEH? unavailable; band restore skipped'
	exit 1
fi
[ -n "$LTE" ] || LTE_MASK=$CUR_LTE
[ -n "$NR" ] || NR_MASK=$CUR_NR

stable=0
rewrites=0
for i in $(seq 24); do
	if { [ -n "$LTE" ] && [ "$CUR_LTE" != "$LTE_MASK" ]; } ||
		{ [ -n "$NR" ] && [ "$CUR_NR" != "$NR_MASK" ]; }; then
		[ -n "$LTE" ] || LTE_MASK=$CUR_LTE
		[ -n "$NR" ] || NR_MASK=$CUR_NR
		cmd="AT+EPBSEH=\"$GSM\",\"$UMTS\",\"$LTE_MASK\",\"$NR_MASK\""
		if "$MODEM" at -t 10 "$cmd" >/dev/null 2>&1; then
			rewrites=$((rewrites + 1))
			stable=0
		else
			stable=0
		fi
	else
		stable=$((stable + 1))
		if [ "$stable" -ge 9 ]; then
			log "saved band masks active; rewrites=$rewrites"
			exit 0
		fi
	fi
	sleep 5
	read_masks || { stable=0; continue; }
	[ -n "$LTE" ] || LTE_MASK=$CUR_LTE
	[ -n "$NR" ] || NR_MASK=$CUR_NR
done

log "band masks did not remain stable; rewrites=$rewrites"
exit 1
