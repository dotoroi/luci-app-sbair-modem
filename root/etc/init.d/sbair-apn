#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 soralis0912
#
# 起動時にモデム設定を復元する。バンド再適用の監視が最大120秒かかるため、
# 初期化処理をバックグラウンドで実行してシステム起動を止めない。
#
# **登録が無ければ何もしない。** 空の APN を書き込むと、ベンダの
# check_auto_apn_prov (SIM から APN を引く仕組み)を潰しかねない。
#
# netifd より後に走らせる。先に走っても ifup する相手がいない。

START=95
STOP=01

boot() {
	# モデムが SIM を読み終えるまで待つ。起動直後は +CCID が空を返す。
	( for i in $(seq 30); do
		[ -n "$(/usr/bin/sbair-modem at 'AT+CCID' 2>/dev/null)" ] && break
		sleep 2
	  done
	  /usr/bin/sbair-modem boot 2>&1 | logger -t sbair-modem-boot
	) &
}

start() {
	/usr/bin/sbair-modem apn apply
	# The ordinary APN apply path intentionally does not rewrite band masks.
	# Restore the saved band selection separately after the modem is ready.
	if [ -x /usr/sbin/air6-band-restore ]; then
		setsid /usr/sbin/air6-band-restore >/dev/null 2>&1 &
	fi
}
