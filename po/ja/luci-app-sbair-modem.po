msgstr "バンドステアリング"

msgid "Bandwidth"
msgstr "帯域幅"

msgid "Bandwidth cannot be changed for legacy Wi-Fi protocols."
msgstr "従来のWi-Fi規格では帯域幅を変更できません。"

msgid "Baud rate: 115200"
msgstr "ボーレート: 115200"

msgid "Beacon / Tx power"
msgstr "ビーコン / 送信出力"

