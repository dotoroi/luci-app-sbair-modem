msgstr "通常のSIMが挿入されています。プロファイルの操作はeUICCカードでのみ可能です。"

msgid "AP / Bridge"
msgstr "AP／ブリッジ"

msgid "AP/Bridge settings"
msgstr "AP／ブリッジ設定"

msgid "AP/Bridge — connects br-lan to the upstream network"
msgstr "AP／ブリッジ — br-lanを上位ネットワークに接続"

msgid "APN settings will not change."
msgstr "APN設定は変更されません。"

msgid "Activate with a click"
msgstr "クリックして有効化"

msgid "Activation Code"
msgstr "アクティベーションコード"

msgid "Activation profile"
msgstr "有効化プロファイル"

msgid "Add"
msgstr "追加"

